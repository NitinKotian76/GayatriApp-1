pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('build docker images') {
            steps {
                withCredentials([file(credentialsId: 'gayatri_env', variable: 'ENV_CONTENTS')]) {
                    sh 'docker compose --build -d --env ENV_CONTENTS'
                }
            }
        }
        stage('Run Django Tests in docker') {
            steps {
                withCredentials([file(credentialsId: 'gayatri_env', variable: 'ENV_CONTENTS')]) {
                    sh 'docker compose up --env ENV_CONTENTS'
                }
                dir('gayatri_invoice/gayatriapp') {
                    sh 'python manage.py test'
                }
            }
        }
        stage('staging') {
            agent { label windows_agent }

        }
        stage('approval') {
        }
        stage('Deploy') {
            steps {
                withCredentials([file(credentialsId: 'gayatri_env', variable: 'ENV_CONTENTS')]) {
                    sh 'docker compose up -d --env ENV_CONTENTS'
                }
            }
        }
    }
    post {
        always {
            sh 'mkdir -p cicd && docker compose logs > cicd/deploy.log || true'
        }
    }
}
