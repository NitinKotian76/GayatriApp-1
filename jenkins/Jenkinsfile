pipeline {
	agent any
	stages {
		stage('Checkout') {
			steps {
				checkout scm
			}
		}
		stage('Install Dependencies') {
			steps {
				dir('gayatri_invoice') {
					sh '''
					curl -LsSf https://astral.sh/uv/install.sh | sh
					uv sync
					uv pip install -r requirements.txt
					'''
				}
			}
		}
		stage('Run Django Tests') {
		    steps {
			withCredentials([file(credentialsId: 'gayatri_env', variable: 'ENV_CONTENTS')]) {
				sh 'docker compose up -d --env ENV_CONTENTS'
			}
		        dir('gayatri_invoice/gayatriapp') {
		            sh 'python manage.py test'
		        }
		    }
		}
		stage('Build Docker Images') {
			steps {
				sh 'docker compose build'
			}
		}
		stage('Collect Static Files') {
			steps {
				sh 'docker compose run --rm gayatriapp python manage.py collectstatic --noinput'
			}
		}
		stage('Migrate Database') {
			steps {
				sh 'docker compose run --rm gayatriapp python manage.py makemigrate'
				sh 'docker compose run --rm gayatriapp python manage.py migrate'
			}
		}
		stage('Deploy') {
			steps {
				withCredentials([file(credentialsId: 'gayatri_env', variable: 'ENV_CONTENTS')]) {
					sh 'docker compose up -d --env ENV_CONTENTS'
				}
			}
		}
	}
	post {
		always {
			sh 'mkdir -p cicd && docker compose logs > cicd/deploy.log || true'
		}
	}
}
